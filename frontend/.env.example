# Copy to `.env` and adjust for your environment.
# When set, the frontend calls this origin directly (production API).
# When unset, same-origin `/api` is used (Vite dev proxy -> localhost:8000).
VITE_API_URL=
# Proxy target override for `npm run dev` (default http://localhost:8000)
# VITE_PROXY_TARGET=http://localhost:8000
